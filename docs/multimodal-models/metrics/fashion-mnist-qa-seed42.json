{
  "schema_version": 1,
  "dataset": "fashion-mnist-qa",
  "evaluation_tier": "l1_public_images",
  "source": "https://github.com/zalandoresearch/fashion-mnist",
  "train_examples": 2000,
  "validation_examples": 1000,
  "test_examples": 1000,
  "seed": 42,
  "steps_per_trial": 150,
  "baseline": {
    "architecture": "micro_vlm_linear",
